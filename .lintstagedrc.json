{
  "*.{ts,tsx,js,jsx}": [
    "prettier --write --cache --cache-location .cache/prettier",
    "eslint --fix --max-warnings=0 --cache --cache-location .cache/eslint",
    "node scripts/lint-staged-typecheck.mjs"
  ],
  "*.{json,css,md,yml,yaml}": [
    "prettier --write --cache --cache-location .cache/prettier"
  ]
}
