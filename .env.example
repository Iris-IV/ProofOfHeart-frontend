# Set to "true" to use mock data instead of live contract calls
NEXT_PUBLIC_USE_MOCKS=true

# Site URL (used for CORS and metadata, defaults to https://proofofheart.xyz)
NEXT_PUBLIC_SITE_URL=https://proofofheart.xyz

# Soroban RPC endpoint (Testnet default shown)
# For mainnet, use the server-side proxy (see MAINNET_RPC_URL below)
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Server-side RPC URLs (never exposed to browser)
# Mainnet RPC with API key (server-side only, kept secret)
MAINNET_RPC_URL=
# Testnet RPC (server-side, optional - defaults to public endpoint)
TESTNET_RPC_URL=https://soroban-testnet.stellar.org

# Stellar network (testnet | mainnet)
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Deployed ProofOfHeart contract address (C…)
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Stellar network passphrase
# Testnet: "Test SDF Network ; September 2015"
# Mainnet: "Public Global Stellar Network ; September 2015"
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Pinata JWT for server-side IPFS image uploads (/api/upload-image)
PINATA_JWT=
# Soroban campaign_vote_cast event poll interval on detail page (ms, default 5000)
NEXT_PUBLIC_VOTE_EVENTS_POLL_MS=5000

# Vote tally reconciliation when event streaming unavailable (ms, default 30000)
NEXT_PUBLIC_VOTE_TALLIES_POLL_MS=30000

# Estimated Soroban network fee (stroops) shown in DonationModal before signing (default 100000 = 0.01 XLM)
# NEXT_PUBLIC_ESTIMATED_CONTRIBUTE_NETWORK_FEE_STROOPS=100000

# --- Server-side webhooks (never exposed to browser, read via API routes) ---

# Webhook URL for creator email opt-in events (called server-side via POST /api/email-opt-in)
CREATOR_EMAIL_WEBHOOK_URL=

# Webhook URL for structured observability events (Datadog, Splunk, etc.;
# forwarded server-side by /api/observability/events)
OBSERVABILITY_WEBHOOK_URL=

# --- Third-party scripts (all optional; unset = zero third-party requests) ---
# Every script below is injected by next/script after hydration, never from <head>.
# Configured origins are added to the CSP automatically — see src/lib/thirdParty.ts.

# Privacy-first analytics vendor: "plausible" | "umami" | unset to disable
NEXT_PUBLIC_ANALYTICS_PROVIDER=
# Override the script URL when self-hosting the vendor (must be https)
NEXT_PUBLIC_ANALYTICS_SRC=
# Plausible only — the site registered in your dashboard, e.g. proofofheart.xyz
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# Umami only — the website id from your dashboard
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=

# Support/chat widget script URL (Crisp, Tawk, Intercom, …), loaded on idle
NEXT_PUBLIC_SUPPORT_WIDGET_SRC=

# --- Social login / embedded wallet (optional) ---
# Web3Auth client id from https://dashboard.web3auth.io — unset hides the
# "Continue with Google / X" buttons and leaves the Freighter-only flow intact.
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=
# Web3Auth key network. Defaults to sapphire_devnet on testnet and
# sapphire_mainnet on mainnet; only set this to pin a different network.
# NEXT_PUBLIC_WEB3AUTH_NETWORK=sapphire_devnet

# Maintenance mode — set to "true" to show the maintenance page to all visitors
# NEXT_PUBLIC_MAINTENANCE_MODE=false
# Comma-separated Stellar wallet addresses that bypass the maintenance page
# NEXT_PUBLIC_MAINTENANCE_ALLOWLIST=GXXX...admin1,GXXX...admin2
# Human-readable ETA shown on the maintenance page (optional)
# NEXT_PUBLIC_MAINTENANCE_ETA=2026-06-02 18:00 UTC

# --- Fiat on-ramp (#637, optional) ---
# Let non-crypto users buy XLM with a card/bank transfer inside the donation
# flow. Opt-in: with no provider set, no on-ramp UI or third-party request ships.
# Provider: "ramp" | "moonpay" | unset to disable
NEXT_PUBLIC_FIAT_ONRAMP_PROVIDER=
# Publishable host/API key from your provider dashboard (never a secret key).
# Ramp: https://dashboard.ramp.network  —  MoonPay: https://dashboard.moonpay.com
NEXT_PUBLIC_RAMP_API_KEY=
NEXT_PUBLIC_MOONPAY_API_KEY=

# Alert thresholds (0–1 rates) evaluated over a 5-minute rolling window
OBSERVABILITY_ALERT_SIMULATION_FAILURE_RATE=0.15
OBSERVABILITY_ALERT_SUBMISSION_FAILURE_RATE=0.1
OBSERVABILITY_ALERT_RPC_TIMEOUT_RATE=0.2
