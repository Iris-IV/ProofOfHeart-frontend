# Every variable below is declared in one place: src/lib/envContract.ts, with the
# Zod schemas and the rules that span several variables in src/lib/envSchema.ts.
# See docs/ENVIRONMENT_VARIABLES.md for the full contract and the boot-time
# validation. A value left empty (=) counts as unset.
#
# How to read this file
#   - NEXT_PUBLIC_*  are inlined into the browser bundle at BUILD time: they are public and a
#     change needs a rebuild. Never put a secret in one.
#   - Everything else is server-only and read at runtime; none of it reaches the browser.
#   - No variable is strictly required. When NEXT_PUBLIC_USE_MOCKS is unset the app makes live
#     contract calls, so for live data set NEXT_PUBLIC_CONTRACT_ADDRESS; this file ships with
#     NEXT_PUBLIC_USE_MOCKS=true so a fresh checkout works without a wallet or contract.
#   - Lines starting with "# NAME=" are optional and show the default or an example; uncomment to use.
#   - Secrets (marked "SECRET") belong in your host's secret store, not in git.
#
# Secret variables: PINATA_JWT, MAINNET_RPC_URL, COMMENT_STORE_REDIS_REST_TOKEN,
# METRICS_SECRET_TOKEN (and the server-side webhook URLs, which may embed tokens).

# Set to "true" to use mock data instead of live contract calls
NEXT_PUBLIC_USE_MOCKS=true

# Site URL (used for CORS and metadata, defaults to https://proofofheart.xyz)
NEXT_PUBLIC_SITE_URL=https://proofofheart.xyz

# Soroban RPC endpoint (Testnet default shown)
# For mainnet, use the server-side proxy (see MAINNET_RPC_URL below)
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Optional secondary RPC. When set, a primary call slower than
# NEXT_PUBLIC_RPC_LATENCY_THRESHOLD_MS (default 3000) or unreachable is retried
# here, and the fallback stays active for 60s before the primary is tried again.
# NEXT_PUBLIC_SOROBAN_RPC_FALLBACK_URL=
# NEXT_PUBLIC_RPC_LATENCY_THRESHOLD_MS=3000

# Server-side RPC URLs (never exposed to browser)
# Mainnet RPC with API key (server-side only, kept secret)
MAINNET_RPC_URL=
# Testnet RPC (server-side, optional - defaults to public endpoint)
TESTNET_RPC_URL=https://soroban-testnet.stellar.org

# Stellar network (testnet | mainnet)
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Deployed ProofOfHeart contract address (C…)
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Stellar network passphrase
# Testnet: "Test SDF Network ; September 2015"
# Mainnet: "Public Global Stellar Network ; September 2015"
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Pinata JWT for server-side IPFS image uploads (/api/upload-image)
PINATA_JWT=

# --- Comment / report persistence (server-only) ---
# Adapter for the off-chain comment, report and rate-limit store.
#   memory  process-local; lost on restart, not shared across instances
#   file    single JSON file at COMMENT_STORE_PATH; survives restart, shared
#           across instances that mount the same path
#   redis   Upstash-compatible Redis REST; survives restart and is shared
#           across all instances (recommended for production)
# Defaults to "file" (and "memory" when NODE_ENV=test or Redis credentials are set).
# COMMENT_STORE_DRIVER=file
# JSON file path used by the file adapter.
# COMMENT_STORE_PATH=.data/poh-store.json
# Shared Redis adapter endpoint + token (both required when the redis adapter is used).
COMMENT_STORE_REDIS_REST_URL=
COMMENT_STORE_REDIS_REST_TOKEN=
# Number of campaigns fetched per page on the /causes list (default 20).
# Increase for faster initial fills on high-bandwidth deployments; decrease
# on slower RPCs.  Must be a positive integer.
# NEXT_PUBLIC_CAMPAIGNS_PAGE_SIZE=20

NEXT_PUBLIC_VOTE_EVENTS_POLL_MS=5000

# Vote tally reconciliation when event streaming unavailable (ms, default 30000)
NEXT_PUBLIC_VOTE_TALLIES_POLL_MS=30000

# Wallet XLM balance refresh (dashboard). Clamped to 10-30s in useStellarBalance.
NEXT_PUBLIC_POLL_INTERVAL_BALANCE_MS=15000

# Estimated Soroban network fee (stroops) shown in DonationModal before signing (default 100000 = 0.01 XLM)
# NEXT_PUBLIC_ESTIMATED_CONTRIBUTE_NETWORK_FEE_STROOPS=100000

# --- Server-side webhooks (never exposed to browser, read via API routes) ---

# Webhook URL for creator email opt-in events (called server-side via POST /api/email-opt-in)
CREATOR_EMAIL_WEBHOOK_URL=

# Webhook URL for structured observability events (Datadog, Splunk, etc.;
# forwarded server-side by /api/observability/events)
OBSERVABILITY_WEBHOOK_URL=

# --- Third-party scripts (all optional; unset = zero third-party requests) ---
# Every script below is injected by next/script after hydration, never from <head>.
# Configured origins are added to the CSP automatically — see src/lib/thirdParty.ts.

# Privacy-first analytics vendor: "plausible" | "umami" | unset to disable
NEXT_PUBLIC_ANALYTICS_PROVIDER=
# Override the script URL when self-hosting the vendor (must be https)
NEXT_PUBLIC_ANALYTICS_SRC=
# Plausible only — the site registered in your dashboard, e.g. proofofheart.xyz
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# Umami only — the website id from your dashboard
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=

# Support/chat widget script URL (Crisp, Tawk, Intercom, …), loaded on idle
NEXT_PUBLIC_SUPPORT_WIDGET_SRC=

# --- Social login / embedded wallet (optional) ---
# Web3Auth client id from https://dashboard.web3auth.io — unset hides the
# "Continue with Google / X" buttons and leaves the Freighter-only flow intact.
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=
# Web3Auth key network. Defaults to sapphire_devnet on testnet and
# sapphire_mainnet on mainnet; only set this to pin a different network.
# NEXT_PUBLIC_WEB3AUTH_NETWORK=sapphire_devnet

# Maintenance mode — set to "true" to show the maintenance page to all visitors
# NEXT_PUBLIC_MAINTENANCE_MODE=false
# Comma-separated Stellar wallet addresses that bypass the maintenance page
# NEXT_PUBLIC_MAINTENANCE_ALLOWLIST=GXXX...admin1,GXXX...admin2
# Human-readable ETA shown on the maintenance page (optional)
# NEXT_PUBLIC_MAINTENANCE_ETA=2026-06-02 18:00 UTC

# --- Fiat on-ramp (#637, optional) ---
# Let non-crypto users buy XLM with a card/bank transfer inside the donation
# flow. Opt-in: with no provider set, no on-ramp UI or third-party request ships.
# Provider: "ramp" | "moonpay" | unset to disable
NEXT_PUBLIC_FIAT_ONRAMP_PROVIDER=
# Publishable host/API key from your provider dashboard (never a secret key).
# Ramp: https://dashboard.ramp.network  —  MoonPay: https://dashboard.moonpay.com
NEXT_PUBLIC_RAMP_API_KEY=
NEXT_PUBLIC_MOONPAY_API_KEY=

# Alert thresholds (0–1 rates) evaluated over a 5-minute rolling window
OBSERVABILITY_ALERT_SIMULATION_FAILURE_RATE=0.15
OBSERVABILITY_ALERT_SUBMISSION_FAILURE_RATE=0.1
OBSERVABILITY_ALERT_RPC_TIMEOUT_RATE=0.2

# --- Server-only operations (optional) ---
# Bearer token that guards the metrics endpoint. SECRET — leave unset to keep it closed.
# METRICS_SECRET_TOKEN=
# Stellar address (G…) granted platform-admin rights on the server.
# PLATFORM_ADMIN_ADDRESS=

# --- Additional polling intervals (ms, optional) ---
# Platform stats listing refresh (default 60000, allowed 1000-600000).
# NEXT_PUBLIC_POLL_INTERVAL_LISTING_MS=60000
# Contribution events when streaming is unavailable (default 30000, allowed 1000-600000).
# NEXT_PUBLIC_CONTRIBUTION_EVENTS_POLL_MS=30000

# --- Public integrations (optional) ---
# Client-side error tracking DSN (https URL). Its origin is added to the CSP connect-src.
# NEXT_PUBLIC_ERROR_TRACKING_DSN=
# Base URL of an external API the browser calls. Its origin is added to the CSP connect-src.
# NEXT_PUBLIC_API_URL=
# Platform tax identifier printed on donation receipts.
# NEXT_PUBLIC_PLATFORM_TAX_ID=

# --- Contract pinning and legacy aliases (optional) ---
# Expected WASM hash of the deployed contract, checked before the app trusts it.
# NEXT_PUBLIC_CONTRACT_WASM_HASH=
# Legacy contract id kept for older integrations; prefer NEXT_PUBLIC_CONTRACT_ADDRESS.
# NEXT_PUBLIC_CONTRACT_ID=
# Legacy alias for NEXT_PUBLIC_SOROBAN_RPC_URL (used only when that one is unset).
# NEXT_PUBLIC_RPC_URL=
# DEPRECATED: use the server-only CREATOR_EMAIL_WEBHOOK_URL above instead.
# NEXT_PUBLIC_CREATOR_EMAIL_WEBHOOK_URL=
